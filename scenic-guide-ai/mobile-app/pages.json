{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "景区AI导游",
        "navigationBarBackgroundColor": "#1a7a4a",
        "navigationBarTextStyle": "white",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/guide/guide",
      "style": {
        "navigationBarTitleText": "AI讲解",
        "navigationBarBackgroundColor": "#1a7a4a",
        "navigationBarTextStyle": "white",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/route/route",
      "style": {
        "navigationBarTitleText": "游览路线",
        "navigationBarBackgroundColor": "#1a7a4a",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/history/history",
      "style": {
        "navigationBarTitleText": "历史记录",
        "navigationBarBackgroundColor": "#1a7a4a",
        "navigationBarTextStyle": "white"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "景区AI导游",
    "navigationBarBackgroundColor": "#1a7a4a",
    "backgroundColor": "#f0f7f4"
  },
  "tabBar": {
    "color": "#999",
    "selectedColor": "#1a7a4a",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "导游",
        "iconPath": "static/tab/home.png",
        "selectedIconPath": "static/tab/home_active.png"
      },
      {
        "pagePath": "pages/route/route",
        "text": "路线",
        "iconPath": "static/tab/route.png",
        "selectedIconPath": "static/tab/route_active.png"
      },
      {
        "pagePath": "pages/history/history",
        "text": "记录",
        "iconPath": "static/tab/history.png",
        "selectedIconPath": "static/tab/history_active.png"
      }
    ]
  }
}
