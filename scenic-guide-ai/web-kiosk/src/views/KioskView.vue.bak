// 各人物类型的推荐缩放比例（基于人物实际高度）
const avatarScaleMap = { chibi: 1.0, live2d: 0.55, sadtalker: 1.0 }
function switchAvatar(type) {
  // 脚底固定在75%位置
  const targetY = 75
  const baseScale = avatarScaleMap[type] || 1.0
  // 更新角色基础缩放
  baseAvatarScale.value = baseScale
  const targetScale = calculateScale(targetY)
  if (avatarStageInner.value) {
    avatarStageInner.value.style.transform =
      `translate(-50%, -100%) scale(${targetScale * 0.9})`
    avatarStageInner.value.style.opacity = '0.5'
  }
  setTimeout(() => {
    currentAvatarType.value = type
    charY.value = targetY
    charScale.value = targetScale
    nextTick(() => {
      if (avatarStageInner.value) {
        avatarStageInner.value.style.transform =
          `translate(-50%, -100%) scale(${charScale.value})`
        avatarStageInner.value.style.opacity = '1'
      }
    })
  }, 180)
}

