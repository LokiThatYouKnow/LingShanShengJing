}

.candidate-words-wrapper::-webkit-scrollbar {
  display: none;  /* Chrome/Safari */
}

.candidate-words {
  display: flex;
  gap: 8px;
  padding: 4px 0;
}

/* 候选词按钮 - 大尺寸触摸友好 */
.candidate-btn {
  min-width: 56px;
  height: 48px;
  padding: 0 14px;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 10px;
  color: #fff;
  font-size: 20px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
  display: flex;
  align-items: center;
