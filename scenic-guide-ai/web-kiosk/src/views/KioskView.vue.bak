// 合并词库
const allDictionary = { ...chineseDictionary, ...scenicWords }

// 分词算法：生成所有可能的分词组合
// 输入"tingche"返回：["停车场", "停车", "停", "车"]
function segmentPinyin(pinyin) {
  if (!pinyin || pinyin.length < 2) return []

  // 收集所有可能的组合结果
  const allResults = []
  const seen = new Set()  // 用于去重

  // 1. 完整匹配优先
  if (allDictionary[pinyin]) {
    for (const word of allDictionary[pinyin]) {
      if (!seen.has(word)) {
        seen.add(word)
        allResults.push(word)
      }
    }
  }

  // 2. 生成所有可能的分词组合
  function generateCombinations(start, currentResult) {
    if (start >= pinyin.length) {
      // 成功分词，收集结果
      if (currentResult.length > 0 && !seen.has(currentResult)) {
        seen.add(currentResult)
        allResults.push(currentResult)
      }
      return
    }

    // 从当前位置尝试匹配1-6个字符（覆盖1-4字词的最长拼音）
    const maxLen = Math.min(6, pinyin.length - start)
    for (let len = 1; len <= maxLen; len++) {
      const part = pinyin.slice(start, start + len)
      if (allDictionary[part]) {
        for (const word of allDictionary[part]) {
          generateCombinations(start + len, currentResult + word)
        }
      }
    }
  }

  generateCombinations(0, '')

  return allResults
}

// 获取候选词
function getCandidates(pinyin) {
  if (!pinyin) return []

  const lower = pinyin.toLowerCase()

  // 收集所有候选词
  const candidates = []

  // 1. 直接匹配（完整拼音精确匹配）
  if (allDictionary[lower]) {
    candidates.push(...allDictionary[lower])
  }

  // 2. 生成分词组合
  const segmented = segmentPinyin(lower)
  if (segmented.length > 0) {
    candidates.push(...segmented)
  }

  // 3. 模糊匹配（前缀匹配）- 补充没有分词成功的情况
  if (candidates.length === 0) {
    for (const key of Object.keys(allDictionary)) {
      if (key.startsWith(lower)) {
        candidates.push(...allDictionary[key])
      }
    }
  }

  // 去重
  const unique = [...new Set(candidates)]

  // 按长度排序，短词优先（这样用户可以逐字选择）
  unique.sort((a, b) => a.length - b.length)

  // 如果短词太多，可能需要去掉太长的组合
  return unique.slice(0, 9)
}

// 选择候选词
function selectCandidate(word) {
  // 将拼音buffer转为汉字后添加到输入框
  inputText.value += word
  pinyinBuffer.value = ''
  candidates.value = []
  candidateIndex.value = -1
}

// 清空拼音输入（只清空，不把内容添加到输入框）
function clearPinyin() {
  if (pinyinBuffer.value) {
    pinyinBuffer.value = ''
    candidates.value = []
    candidateIndex.value = -1
  }
}

// 切换输入法模式
function toggleInputMode() {
  inputMode.value = inputMode.value === 'en' ? 'cn' : 'en'
  // 切换模式时清空拼音buffer
  if (pinyinBuffer.value) {
    inputText.value += pinyinBuffer.value
    pinyinBuffer.value = ''
    candidates.value = []
  }
}

function inputKey(key) {
  if (inputMode.value === 'cn') {
    // 中文模式
    // 数字键直接输入，不进入拼字框
    if (/^\d$/.test(key)) {
      inputText.value += key
      return
    }
    // 字母键收集拼音
    pinyinBuffer.value += key
    candidates.value = getCandidates(pinyinBuffer.value)
    candidateIndex.value = -1
  } else {
    // 英文模式
    if (isShifted.value) {
      inputText.value += key.toUpperCase()
      isShifted.value = false
    } else {
      inputText.value += key
    }
  }
}

function handleBackspace() {
  if (pinyinBuffer.value) {
    pinyinBuffer.value = pinyinBuffer.value.slice(0, -1)
    if (pinyinBuffer.value) {
      candidates.value = getCandidates(pinyinBuffer.value)
    } else {
      candidates.value = []
    }
    candidateIndex.value = -1
  } else {
    inputText.value = inputText.value.slice(0, -1)
  }
}

function handleShift() {
  isShifted.value = !isShifted.value
}

function toggleSymbols() {
  // 切换到标点符号键盘模式
  keyboardMode.value = keyboardMode.value === 'qwerty' ? 'symbol' : 'qwerty'
}

function handleEnter() {
  // 如果有拼音buffer，先转为汉字
  if (pinyinBuffer.value) {
    inputText.value += pinyinBuffer.value
    pinyinBuffer.value = ''
    candidates.value = []
  }
  if (inputText.value.trim()) {
    sendMessage()
  }
  showKeyboard.value = false
}

// 点击输入框时自动显示键盘
function focusInput() {
  showKeyboard.value = true
}

// 景点背景样式（不再依赖图片，使用渐变+水印背景）
const spotBgStyle = computed(() => ({
  background: `linear-gradient(135deg, #0f2018 0%, #1a3a28 30%, #0d2a1a 60%, #162e20 100%)`
}))

// 头发样式（根据发型变化）
const currentHairStyle = computed(() => {
  const color = currentOutfit.value.hairColor
  const style = currentOutfit.value.hairStyle
  const base = {
    background: `linear-gradient(180deg, ${color} 0%, ${adjustColor(color, -20)} 100%)`,
  }
  if (style === 'bun') {
    return { ...base }
  }
  return base
})

// 迷你角色预览样式
const miniCharStyle = computed(() => ({
  '--hair-color': currentOutfit.value.hairColor,
}))

// 工具函数：调整颜色亮度
function adjustColor(hex, amount) {
  const num = parseInt(hex.replace('#', ''), 16)
  const r = Math.min(255, Math.max(0, (num >> 16) + amount))
  const g = Math.min(255, Math.max(0, ((num >> 8) & 0xff) + amount))
  const b = Math.min(255, Math.max(0, (num & 0xff) + amount))
  return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1)
}

// 计时器
let timeTimer = null
let idleTimer = null
let blinkTimer = null
let mediaRecorder = null
let audioChunks = []

onMounted(async () => {
  updateTime()
  timeTimer = setInterval(updateTime, 1000)
  startBlinking()
  checkConnection()
  resetIdle()
  // 加载外部词典
  loadDictionary()
  // 获取景点数据
  await fetchSpots()
  // 初始化人物位置（默认在前景中央偏上）
  charX.value = 50
  charY.value = 55
  baseAvatarScale.value = avatarScaleMap['chibi']
  charScale.value = calculateScale(55)
  // 初始场景分析（无图片，传景点名）
  setTimeout(() => { analyzeScene('') }, 500)
  setTimeout(() => { autoGreet() }, 1500)
})

onUnmounted(() => {
  clearInterval(timeTimer)
  clearInterval(blinkTimer)
  clearTimeout(idleTimer)
})

function updateTime() {
  const now = new Date()
  currentTime.value = now.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
  currentDate.value = now.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' })
}

function startBlinking() {
  blinkTimer = setInterval(() => {
    isBlinking.value = true
    setTimeout(() => { isBlinking.value = false }, 150)
  }, 3000)
}

async function checkConnection() {
  try {
    const resp = await fetch('/api/health')
    isConnected.value = resp.ok
  } catch {
    isConnected.value = false
  }
}

// 获取景点数据
async function fetchSpots() {
  try {
    const resp = await fetch('/api/scenic/spots')
    if (resp.ok) {
      const result = await resp.json()
      nearbySpots.value = result.data?.spots || []
    }
  } catch (e) {
    console.error('获取景点数据失败:', e)
  }
}

function resetIdle() {
  isIdle.value = false
  clearTimeout(idleTimer)
  idleTimer = setTimeout(() => {
    // AI 正在思考或数字人正在播放时，不进入待机，重新计时
    if (isLoading.value || isTalking.value) {
      resetIdle()
      return
    }
    isIdle.value = true
  }, 60000)
}

async function autoGreet() {
  const greeting = '您好！欢迎来到' + scenicName.value + '，我是您的AI智能导览助手小青，有任何问题随时问我哦！'
  await speak(greeting)
}

/**
 * 播放 SadTalker 生成的数字人视频
 */
async function playSadTalkerVideo(url) {
  if (!url) return
  // 转换为相对路径（通过 Vite 代理访问）
  const videoPath = url.replace('http://localhost:8001', '')
  avatarVideoUrl.value = videoPath
  sadtalkerPhase.value = 'speaking'
  currentSubtitle.value = '数字人讲解中...'
  isTalking.value = true
  // :src 已绑定 avatarVideoUrl，浏览器会自动加载视频
  // loadedmetadata 事件触发后 onVideoLoaded 会调用 play()
}

// 视频加载成功回调
function onVideoLoaded(e) {
  const videoEl = e.target
  console.log('[SadTalker] 视频元数据加载成功:', videoEl.videoWidth, 'x', videoEl.videoHeight, '时长:', videoEl.duration, 's')
  // autoplay 可能因浏览器策略失败，这里确保播放
  videoEl.play().catch(err => {
    console.warn('[SadTalker] 元数据加载后播放失败:', err)
  })
}

// 视频播放结束回调
function onVideoEnded() {
  console.log('[SadTalker] 视频播放结束')
  isTalking.value = false
  avatarVideoUrl.value = ''
  sadtalkerPhase.value = 'idle'
  currentSubtitle.value = ''
  resetIdle()  // 视频结束，重置待机计时器
}

async function speak(text) {
  currentSubtitle.value = text
  isTalking.value = true
  try {
    const resp = await fetch('/api/voice/tts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text, voice: 'zh-CN-XiaoxiaoNeural', speed: 1.0 })
    })
    if (resp.ok) {
      const blob = await resp.blob()
      const url = URL.createObjectURL(blob)
      const audio = new Audio(url)
      await audio.play()
      audio.onended = () => {
        isTalking.value = false
        currentSubtitle.value = ''
        URL.revokeObjectURL(url)
        resetIdle()  // TTS 播放结束，重置待机计时器
      }
    } else {
      isTalking.value = false
      currentSubtitle.value = ''
      resetIdle()  // TTS 失败，重置待机计时器
    }
  } catch {
    setTimeout(() => {
      isTalking.value = false
      currentSubtitle.value = ''
      resetIdle()  // TTS 异常结束，重置待机计时器
    }, Math.min(text.length * 150, 5000))
  }
}

async function sendMessage() {
  if (!inputText.value.trim() || isLoading.value) return
  const text = inputText.value.trim()
  inputText.value = ''
  await processQuery(text)
}

async function askQuick(q) {
  await processQuery(q)
}

async function processQuery(text) {
  const msgId = Date.now()
  messages.value.push({
    id: msgId,
    role: 'user',
    content: text,
    time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })
  })
  await scrollToBottom()
  isLoading.value = true

  try {
    // SadTalker 模式下要求后端生成数字人视频
    const generateVideo = currentAvatarType.value === 'sadtalker'

    const resp = await fetch('/api/chat/message', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        message: text,
        session_id: 'kiosk_' + (store.sessionId || 'default'),
        context: { spot: currentSpot.value, mode: 'kiosk' },
        generate_video: generateVideo,
        generate_audio: true  // SadTalker 需要先 TTS 生成音频，再驱动视频
      })
    })

    let answer = ''
    let videoUrl = ''
    if (resp.ok) {
      const data = await resp.json()
      // Python 后端返回 { session_id, answer, audio_url, video_url, emotion, ... }
      // Spring Boot 返回 { code, data: { answer, videoUrl, ... } }
      answer = data.data?.answer || data.answer || '抱歉，我没有找到相关信息。'
      // 兼容两种字段名：video_url (Python) / videoUrl (Spring Boot)
      videoUrl = data.data?.videoUrl || data.videoUrl || data.video_url || ''
      console.log('[SadTalker] 后端返回 videoUrl:', videoUrl, '完整响应:', data)
      // 如果有 SadTalker 视频，切换到生成中状态
      if (videoUrl) {
        console.log('[SadTalker] 检测到视频URL，准备播放:', videoUrl)
        // SadTalker 模式下显示生成中状态
        if (currentAvatarType.value === 'sadtalker') {
          sadtalkerPhase.value = 'generating'
        }
        await playSadTalkerVideo(videoUrl)
      }
    } else {
      answer = '系统繁忙，请稍后再试。'
    }

    messages.value.push({
      id: Date.now(),
      role: 'assistant',
      content: answer,
      time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })
    })
    await scrollToBottom()

    // 如果有 SadTalker 视频，直接用视频（自带音频）；否则降级用 TTS
    if (!videoUrl) {
      await speak(answer)
    }
  } catch (err) {
    messages.value.push({
      id: Date.now(),
      role: 'assistant',
      content: '网络连接异常，请检查网络后重试。',
      time: new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })
    })
  } finally {
    isLoading.value = false
    resetIdle()  // AI 结束工作，重置待机计时器，给用户留时间阅读
  }
}

async function startVoice() {
  if (isRecording.value || isLoading.value) return
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
    audioChunks = []
    mediaRecorder = new MediaRecorder(stream)
    mediaRecorder.ondataavailable = e => audioChunks.push(e.data)
    mediaRecorder.onstop = async () => {
      stream.getTracks().forEach(t => t.stop())
      const blob = new Blob(audioChunks, { type: 'audio/webm' })
      await transcribeAudio(blob)
    }
    mediaRecorder.start()
    isRecording.value = true
    voiceStatus.value = '正在录音，请说话...'
  } catch {
    voiceStatus.value = '麦克风权限被拒绝'
    setTimeout(() => { voiceStatus.value = '' }, 2000)
  }
}

function stopVoice() {
  if (!isRecording.value || !mediaRecorder) return
  isRecording.value = false
  voiceStatus.value = '正在识别语音...'
  mediaRecorder.stop()
}

async function transcribeAudio(blob) {
  try {
    voiceStatus.value = '正在识别语音，请稍候...'
    const formData = new FormData()
    formData.append('audio', blob, 'recording.webm')
    formData.append('language', 'zh')
    
    console.log('开始语音识别，上传音频大小:', blob.size, '字节')
    const resp = await fetch('/api/voice/transcribe', { 
      method: 'POST', 
      body: formData 
    })
    
    if (resp.ok) {
      const data = await resp.json()
      voiceStatus.value = ''
      console.log('识别结果:', data)
      if (data.text) {
        inputText.value = data.text
        await processQuery(data.text)
      } else {
        voiceStatus.value = '未能识别到语音内容，请重试'
        setTimeout(() => { voiceStatus.value = '' }, 3000)
      }
    } else {
      const errorText = await resp.text()
      console.error('语音识别失败:', resp.status, errorText)
      voiceStatus.value = '语音识别失败: ' + (errorText || resp.statusText)
      setTimeout(() => { voiceStatus.value = '' }, 3000)
    }
  } catch (err) {
    console.error('语音识别异常:', err)
    voiceStatus.value = '语音服务异常: ' + err.message
    setTimeout(() => { voiceStatus.value = '' }, 3000)
  }
}

// ========== 2D人物移动和位置控制 ==========

// 角色基础缩放比例（用于景深缩放计算）
const baseAvatarScale = ref(1.0)

/**
 * 根据Y坐标计算景深缩放比例（相对值 0-1）
 * Y越大（越靠近屏幕）= 越大
 * Y越小（越远离屏幕）= 越小
 */
function calculateDepthRatio(y) {
  const { minY, maxY } = depthConfig.value
  const range = maxY - minY
  if (range <= 0) return 1
  const clampedY = Math.max(minY, Math.min(maxY, y))
  return (clampedY - minY) / range
}

/**
 * 计算实际缩放值（基于角色基础比例）
 */
function calculateScale(y) {
  const ratio = calculateDepthRatio(y)
  return baseAvatarScale.value * (0.6 + ratio * 0.7)
}

/**
 * 缓动函数 - easeOutCubic
 */
function easeOutCubic(t) {
  return 1 - Math.pow(1 - t, 3)
}

/**
 * 移动人物到指定位置
 */
function moveCharacterTo(newX, newY, duration = 800) {
  if (isMoving.value) {
    // 如果正在移动，取消当前动画
    if (moveAnimationId) {
      cancelAnimationFrame(moveAnimationId)
    }
  }
  
  const startX = charX.value
  const startY = charY.value
  const startScale = charScale.value
  const endScale = calculateScale(newY)
  
  targetX.value = newX
  targetY.value = newY
  isMoving.value = true
  
  const startTime = performance.now()
  
  function animate(currentTime) {
    const elapsed = currentTime - startTime
    const progress = Math.min(elapsed / duration, 1)
    const eased = easeOutCubic(progress)
    
    // 插值位置
    charX.value = startX + (newX - startX) * eased
    charY.value = startY + (newY - startY) * eased
    
    // 插值缩放
    charScale.value = startScale + (endScale - startScale) * eased
    
    if (progress < 1) {
      moveAnimationId = requestAnimationFrame(animate)
    } else {
      // 动画结束
      charX.value = newX
      charY.value = newY
      charScale.value = endScale
      isMoving.value = false
      moveAnimationId = null
    }
  }
  
  moveAnimationId = requestAnimationFrame(animate)
}

/**
 * 点击背景区域移动人物
 */
function onSceneClick(event) {
  // 如果正在加载中，不响应点击（但换装面板和对话时仍可移动）
  if (isLoading.value) return
  // SadTalker 数字人不随点击移动
  if (currentAvatarType.value === 'sadtalker') return
  
  const container = event.currentTarget
  const rect = container.getBoundingClientRect()
  
  // 计算点击位置相对于容器的百分比
  const clickX = ((event.clientX - rect.left) / rect.width) * 100
  const clickY = ((event.clientY - rect.top) / rect.height) * 100
  
  // 限制移动范围（避免太靠边）
  const clampedX = Math.max(15, Math.min(85, clickX))
  const clampedY = Math.max(depthConfig.value.minY, Math.min(depthConfig.value.maxY, clickY))
  
  // 移动人物
  moveCharacterTo(clampedX, clampedY, 1000)
}

/**
 * 分析场景图片，获取路径信息
 */
async function analyzeScene(imageUrl) {
  try {
    // 如果是本地图片，先上传分析
    if (imageUrl && !imageUrl.startsWith('data:')) {
      const resp = await fetch('/api/scene/simple-analyze', {
        method: 'POST',
        headers: {},
      })
      
      if (resp.ok) {
        const data = await resp.json()
        scenePaths.value = data.paths || []
        sceneObstacles.value = data.obstacles || []
        depthConfig.value.minY = data.depth_range?.min_y || 35
        depthConfig.value.maxY = data.depth_range?.max_y || 90
        
        if (data.default_position) {
          defaultPosition.value = data.default_position
          charX.value = data.default_position.x
          charY.value = data.default_position.y
          charScale.value = calculateScale(charY.value)
        }
        console.log('场景分析完成:', data)
      }
    }
  } catch (err) {
    console.error('场景分析失败:', err)
    // 使用默认配置
    depthConfig.value = {
      minY: 35,
      maxY: 90,
      minScale: 0.6,
      maxScale: 1.3
    }
  }
}

function selectSpot(spot) {
  selectedSpot.value = spot
  showSpotDetail.value = true
  currentSpot.value = spot.name
  kioskStore.setSpot(spot.name)
  
  // 分析新场景（无图片，传空串）
  analyzeScene('')
}

function applyOutfit(outfit) {
  currentOutfit.value = { ...outfit }
}

function applyLive2dOutfit(outfit) {
  live2dOutfit.value = { ...outfit }
}

function selectOutfit(preset) {
  currentOutfit.value = { ...preset }
  showOutfitPanel.value = false
}

async function startGuide(spot) {
  currentSpot.value = spot.name
  showSpotDetail.value = false
  await processQuery('请介绍一下' + spot.name + '的历史文化和特色看点')
}

function clearChat() {
  messages.value = []
}

async function scrollToBottom() {
  await nextTick()
  if (chatMessages.value) {
    chatMessages.value.scrollTop = chatMessages.value.scrollHeight
  }
}
</script>

